{
  "name": "@aodhanhayter/pi-optchat-rs",
  "version": "0.1.0",
  "license": "MIT",
  "author": "Aodhan Hayter",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AodhanHayter/optchat-rs.git"
  },
  "engines": { "node": ">=22.19.0" },
  "os": ["linux", "darwin", "win32"],
  "cpu": ["x64", "arm64"],
  "files": ["pi/*.ts", "!pi/*.test.ts", "bin/", "docs/*.md"],
  "publishConfig": { "access": "public" },
  "packageManager": "pnpm@11.25.0",
  "type": "module",
  "description": "Pi adapter for the optchat Rust memory engine",
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./pi/index.ts"
    ]
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --test pi/*.test.ts tests/pi-sdk.test.ts tests/browser.test.mjs",
    "lint": "oxlint",
    "prepack": "node scripts/check-package.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "1.0.2",
    "@earendil-works/pi-ai": "1.0.2",
    "@earendil-works/pi-coding-agent": "1.0.2",
    "@oxlint/plugins": "1.87.0",
    "@types/node": "22.19.19",
    "oxlint": "1.87.0",
    "typebox": "1.3.27",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "effect": "4.0.1"
  }
}
